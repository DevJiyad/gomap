{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build and Run Go",
      "type": "shell",
      "command": "go build -o main.exe \"${fileDirname}\" ; if ($?) { ./main.exe }",
      "problemMatcher": ["$go"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
